<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0A1628"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💥 GAME OVER"
        android:textSize="40sp"
        android:textColor="#FF6B6B"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="20dp"
        android:layout_marginBottom="30dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏁 Điểm số: 0"
            android:textSize="24sp"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📏 Quãng đường: 0m"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 Coin: 0"
            android:textSize="20sp"
            android:textColor="#FFD700"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvGems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💎 Ngọc: 0"
            android:textSize="20sp"
            android:textColor="#00FFCC"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTotalCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 Tổng coins: 0"
            android:textSize="22sp"
            android:textColor="#FFD700"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:text="🔄 CHƠI LẠI"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnMenu"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:text="🏠 MENU CHÍNH"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"/>

</LinearLayout>